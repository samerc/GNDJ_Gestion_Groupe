<?xml version="1.0" encoding="utf-8"?>
<!--
  Project web.config for the GNDJ API. `dotnet publish` (Web SDK) uses this as the base and only rewrites the
  <aspNetCore> processPath/arguments/stdout attributes for the published output — every other attribute and
  element below is preserved. This is the SUPPORTED way to customize ASP.NET Core Module (ANCM) settings; we
  deliberately do NOT patch the generated web.config from publish.ps1 (adding <httpErrors> there caused the
  2026-08-16 startup outage). We only touch ANCM timeouts + Application Initialization here — nothing else.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        startupTimeLimit (default 120s) raised to 240s: this app's startup is heavy (EF migrate + ~15 idempotent
        seeders + data patches) and the box is SHARED with ~10 other sites; under contention a slow startup could
        exceed 120s and get killed by ANCM (event 5078 "unhealthy condition ... requested a recycle"), which then
        cold-starts again. A longer limit lets a slow startup ride out instead of recycling.
        shutdownTimeLimit 30s: give in-flight work (e.g. the email outbox / background services) time to drain.
      -->
      <aspNetCore processPath="dotnet" arguments=".\GNDJ.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" startupTimeLimit="240" shutdownTimeLimit="30" />
      <!--
        Application Initialization: after a recycle/reboot IIS auto-sends this request (paired with the site's
        preloadEnabled=true) so the app warms itself BEFORE the first user arrives. Pointing it at /health means
        the warm-up now also touches the DB (see DatabaseHealthCheck) — priming the Npgsql/EF path, not just the
        static shell. doAppInitAfterRestart re-warms after every recycle, not only the first cold start.
      -->
      <applicationInitialization doAppInitAfterRestart="true">
        <add initializationPage="/health" />
      </applicationInitialization>
    </system.webServer>
  </location>
</configuration>
